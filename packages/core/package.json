{
  "name": "@usecairn/core",
  "version": "0.1.0",
  "description": "Core domain of Cairn: stone schema, frontmatter files, acceptance lint, status transitions, proof integrity.",
  "keywords": [
    "cairn",
    "stones",
    "acceptance-criteria",
    "specification",
    "feature-registry",
    "playwright",
    "proofs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rochesebastien/cairn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rochesebastien/cairn.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rochesebastien/cairn/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./stone-parse": {
      "types": "./dist/stone-parse.d.ts",
      "default": "./dist/stone-parse.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "ulid": "^3.0.2",
    "yaml": "^2.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
