{
  "name": "@usecairn/mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the cairn to agents: stones, drafts, amendments, proof runs and the acceptance lint.",
  "keywords": [
    "cairn",
    "mcp",
    "model-context-protocol",
    "stones",
    "acceptance-criteria",
    "specification",
    "feature-registry",
    "ai-agents"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rochesebastien/cairn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rochesebastien/cairn.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/rochesebastien/cairn/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cairn-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@usecairn/cli": "workspace:*",
    "@usecairn/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
