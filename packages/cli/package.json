{
  "name": "@usecairn/cli",
  "version": "0.1.0",
  "description": "The cairn command line: raise stones, run proofs, keep the registry honest.",
  "keywords": [
    "cairn",
    "cli",
    "stones",
    "acceptance-criteria",
    "specification",
    "feature-registry",
    "playwright",
    "proofs"
  ],
  "license": "MIT",
  "homepage": "https://github.com/rochesebastien/cairn#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rochesebastien/cairn.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rochesebastien/cairn/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cairn": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@usecairn/core": "workspace:*",
    "commander": "^12.1.0",
    "jiti": "^2.4.2",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
